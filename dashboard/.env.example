# Copie para .env.local e preencha. Valores reais NÃO vão pro git.

# Google Analytics 4 / Search Console (já em uso)
GA4_PROPERTY_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN_GSC=
GOOGLE_REFRESH_TOKEN_GBP=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Supabase (CRM)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# service_role: server-side APENAS (lib/operacao.ts → /api/operacao). Sem prefixo
# NEXT_PUBLIC_, então o Next nunca manda pro browser. A partir da migration 0002 as
# tabelas do CRM têm RLS deny-all, e esta é a única chave que lê lead.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
