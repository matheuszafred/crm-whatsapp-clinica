# Copie para .env no servidor e preencha. NÃO commitar valores reais.

SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase → Settings → API → service_role (secreta, roda só no servidor)
SUPABASE_SERVICE_ROLE_KEY=

# Pasta onde a sessão do WhatsApp é persistida (mapeada pra volume no Docker)
SESSION_STORAGE_PATH=./auth_info

# Número novo (só dígitos, formato internacional) → parear por CÓDIGO em vez de QR.
# Ex.: 5511999999999. Se vazio, cai no QR.
PAIRING_NUMBER=
